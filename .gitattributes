# Keep line endings stable across Windows / Linux / macOS checkouts.

# Gradle wrapper: must stay LF and executable on Linux/macOS runners.
gradlew text eol=lf
*.sh text eol=lf

# Windows batch files need CRLF.
*.bat text eol=crlf

# Source and text files: normalized to LF in the repository.
*.java text eol=lf
*.gradle text eol=lf
*.md text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.cfg text eol=lf

# Binary helpers / assets: never touch them.
*.jar binary
*.png binary
*.gif binary
*.class binary
gradle/wrapper/gradle-wrapper.jar binary
